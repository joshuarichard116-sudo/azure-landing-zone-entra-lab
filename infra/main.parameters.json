{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "orgPrefix": {
      "value": "contoso"
    },
    "location": {
      "value": "eastus2"
    },
    "allowedLocations": {
      "value": [
        "eastus2",
        "centralus"
      ]
    },
    "tags": {
      "value": {
        "Environment": "lab",
        "Owner": "cloud-security-lab",
        "CostCenter": "lab",
        "DataClassification": "Non-CUI"
      }
    },
    "logRetentionDays": {
      "value": 30
    },
    "dailyCapGb": {
      "value": 1
    },
    "budgetAmount": {
      "value": 5
    },
    "budgetContactEmails": {
      "value": [
        "lab-owner@example.com"
      ]
    }
  }
}